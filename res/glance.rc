#include <winver.h>
#include "version.h"

1 ICON "glance.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GV_MAJ,GV_MIN,GV_PAT,0
PRODUCTVERSION GV_MAJ,GV_MIN,GV_PAT,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Glance photo viewer"
      VALUE "ProductName", "Glance"
      VALUE "FileVersion", GV_STR
      VALUE "ProductVersion", GV_STR
      VALUE "OriginalFilename", "Glance.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
